# PeerReviewAgents — example secrets file.
#
# Copy this to `.env` (gitignored) and chmod it 600 so only you can read it:
#   cp .env.example .env && chmod 600 .env
#
# This file is for API KEYS ONLY.  Provider, model, and workflow settings
# belong in `peerreview.toml` — see peerreview.toml.example.
# `peerreview` loads this file automatically at startup via python-dotenv.

# Anthropic (Claude) — used when provider = "anthropic" (the default).
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used when provider = "openai".
# OPENAI_API_KEY=sk-...

# OpenRouter — used when provider = "openrouter".
# (Either OPENROUTER_API_KEY or OPENAI_API_KEY is honored.)
# OPENROUTER_API_KEY=sk-or-...

# Google (Gemini) — used when provider = "google".
# Requires the optional extra: `just install-extras google`
# GOOGLE_API_KEY=...

# Ollama runs locally and needs no key.

# --- Research layer keys ---------------------------------------------------

# Tavily — web search + URL extract used by the literature, novelty, and
# citation-integrity reviewers when "tavily" is in research_tools.
# Free tier: ~1000 queries/month. Sign up at https://tavily.com
# Without this key, Tavily tools are silently omitted and the agents fall
# back to arXiv + Semantic Scholar only.
# TAVILY_API_KEY=tvly-...

# Semantic Scholar — optional. Without a key you share a heavily throttled
# public bucket (frequent 429s when reviewers run in parallel).
# Request one at https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=...
