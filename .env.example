# PeerReviewAgents — example secrets file.
#
# Copy this to `.env` (gitignored) and chmod it 600 so only you can read it:
#   cp .env.example .env && chmod 600 .env
#
# This file is for API KEYS ONLY.  Provider, model, and workflow settings
# belong in `peerreview.toml` — see peerreview.toml.example.
# `peerreview` loads this file automatically at startup via python-dotenv.

# OpenRouter — used when provider = "openrouter" (the default). One key
# reaches any model on the platform. OPENAI_API_KEY is accepted as a
# fallback, since OpenRouter speaks the OpenAI API.
# OPENROUTER_API_KEY=sk-or-...

# Anthropic (Claude) direct — used when provider = "anthropic".
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direct — used when provider = "openai".
# OPENAI_API_KEY=sk-...

# Those three are the whole list — see peerreviewagents/runtime/providers.py.
# PDF ingest needs no key: rustypaper converts the file in-process.

# --- Research layer keys ---------------------------------------------------
#
# Only the novelty and literature reviewers and the citation-integrity
# auditor make these calls, and only while research is enabled (it is by
# default; --offline turns it off). arXiv and bioRxiv need no key.

# Semantic Scholar — optional. Without a key you share a heavily throttled
# public bucket (frequent 429s when reviewers run in parallel); the router
# falls through to the next vendor in `data_vendors` on a rate-limit.
# Request one at https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=...

# NCBI (PubMed E-utilities) — optional. Raises the rate limit from 3 to 10
# requests/second. https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
# NCBI_API_KEY=...
