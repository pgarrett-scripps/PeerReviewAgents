# PeerReviewAgents — example configuration file.
#
# Copy this to `peerreview.toml` (gitignored) at the repo root for
# project-local settings, or to ~/.config/peerreviewagents/config.toml
# for personal defaults that apply everywhere.  Both are loaded if both
# exist; project-local wins on conflicts.
#
# Anything you don't set keeps its built-in default.  CLI flags and
# PEERREVIEW_* env vars still override these values.
#
# This file is for NON-SECRET settings.  API keys belong in `.env`:
#   OPENROUTER_API_KEY  — text + vision models + server-side web search
#   DATALAB_API_KEY     — PDF ingest

# ---------------------------------------------------------------------------
# Models (OpenRouter)
# ---------------------------------------------------------------------------

# Single text model used by every reviewer, debater, synthesizer,
# integrity auditor, and the editor-in-chief. Pick any OpenRouter slug.
reasoning_model = "anthropic/claude-opus-4.1"

# Multimodal model used during ingest to describe each extracted figure.
# Must accept image input.
vision_model = "anthropic/claude-haiku-4.5"

# ---------------------------------------------------------------------------
# Workflow
# ---------------------------------------------------------------------------

# Advocate ⇄ Skeptic debate rounds.
debate_rounds = 2

# ---------------------------------------------------------------------------
# PDF ingest (Datalab marker API)
# ---------------------------------------------------------------------------
#
# PDFs are parsed via https://www.datalab.to/api/v1/marker. Put your key
# in `.env` as DATALAB_API_KEY=... — it's not read from this file.
# Free tier includes $5 of credits on signup; pricing is per page.
#
# Defaults below are tuned for academic manuscripts; uncomment to override.

# Force OCR even on PDFs that already have a text layer.
# pdf_force_ocr = false

# Let Datalab spend extra LLM cycles cleaning tables / headings. Costs more
# per page but produces nicer markdown for messy two-column papers.
# pdf_use_llm = false

# Cap pages sent for processing (None = full document).
# pdf_max_pages = 30

# Pass a page range like "0-5,10" (0-indexed) for partial ingest.
# pdf_page_range = "0-9"

# OCR language hint when force_ocr is on, e.g. "English".
# pdf_langs = "English"

# ---------------------------------------------------------------------------
# Figure understanding (vision model)
# ---------------------------------------------------------------------------
#
# Every extracted figure is sent to `vision_model` and its description is
# injected back into the manuscript markdown so the text-only reviewers
# can reason about figure content. Cost scales with figure count, not
# with reviewer count.

# Hard cap on figures described per manuscript (cost control).
vision_max_figures = 10

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

# Where per-run report directories are written.
output_dir = "./reports"

# ---------------------------------------------------------------------------
# Manuscript cache
# ---------------------------------------------------------------------------
#
# Parsing a PDF via the Datalab API (and the vision pass) is the slowest
# step in the pipeline. The parsed (title, markdown, sections) triple is
# always cached on disk keyed by file content + the ingest config slice,
# so re-running on the same paper is instant. Inspect / wipe with
# `just cache-info` and `just cache-clear`.

# Where to store cache entries. Leave unset to use $XDG_CACHE_HOME (or
# ~/.cache) under peerreviewagents/manuscripts/.
# cache_dir = "~/.cache/peerreviewagents/manuscripts"
